import GSN.Model
namespace GSN
variable {A D : Type} [DecidableEq A] [DecidableEq D]

/-- listed(X, Y, d) and X ≠ Y  ⇒  knows(X, Y) -/
theorem p135_init : ∀ (x0 : A) (x1 : A) (x2 : D), (init : St A D).listed x0 x1 x2 > 0 → x0 ≠ x1 → (init : St A D).knows x0 x1 > 0 := by
  simp [init]


namespace GSN
variable {A D : Type} [DecidableEq A] [DecidableEq D]

/-- The properties proved, conjoined. -/
def Props (s : St A D) : Prop :=
  (∀ (x0 : A), s.identity x0 ≤ 1) ∧
  (∀ (x0 : A) (x1 : A), s.friend x0 x1 ≤ 1) ∧
  (∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → x0 ≠ x1) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 ≤ 1) ∧
  (∀ (x0 : A) (x1 : D) (x2 : A), s.received x0 x1 x2 > 0 → x0 ≠ x2) ∧
  (∀ (x0 : A) (x1 : D), s.closed x0 x1 ≤ 1) ∧
  (∀ (x0 : A) (x1 : D) (x2 : D), s.posted x0 x1 x2 ≤ 1) ∧
  (∀ (x0 : A) (x1 : D) (x2 : A) (x3 : D), s.delivered x0 x1 x2 x3 ≤ 1) ∧
  (∀ (x0 : A) (x1 : D) (x2 : A) (x3 : D), s.delivered x0 x1 x2 x3 > 0 → x0 ≠ x2) ∧
  (∀ (x0 : A) (x1 : D) (x2 : A) (x3 : D), s.received_in x0 x1 x2 x3 ≤ 1) ∧
  (∀ (x0 : A) (x1 : D) (x2 : A) (x3 : D), s.received_in x0 x1 x2 x3 > 0 → x0 ≠ x2) ∧
  (∀ (x0 : A), s.identity x0 > 0 → s.friend x0 x0 = 0) ∧
  (∀ (x0 : A) (x1 : A), s.knows x0 x1 > 0 → s.identity x0 > 0) ∧
  (∀ (x0 : A) (x1 : A), s.knows x0 x1 > 0 → s.identity x1 > 0) ∧
  (∀ (x0 : A) (x1 : A), s.knows x0 x1 > 0 → s.friend x0 x0 = 0) ∧
  (∀ (x0 : A) (x1 : A), s.knows x0 x1 > 0 → s.friend x1 x1 = 0) ∧
  (∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.identity x0 > 0) ∧
  (∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.identity x1 > 0) ∧
  (∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.knows x0 x1 > 0) ∧
  (∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.knows x1 x0 > 0) ∧
  (∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.friend x0 x0 = 0) ∧
  (∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.friend x1 x0 > 0) ∧
  (∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.friend x1 x1 = 0) ∧
  (∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.identity x0 > 0) ∧
  (∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.identity x1 > 0) ∧
  (∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.friend x0 x0 = 0) ∧
  (∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.friend x1 x1 = 0) ∧
  (∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.received x0 x2 x0 = 0) ∧
  (∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.received x1 x2 x1 = 0) ∧
  (∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.delivered x0 x2 x0 x2 = 0) ∧
  (∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.delivered x1 x2 x1 x2 = 0) ∧
  (∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.received_in x0 x2 x0 x2 = 0) ∧
  (∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.received_in x1 x2 x1 x2 = 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.identity x0 > 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.identity x1.1 > 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.friend x0 x0 = 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.friend x1.1 x1.1 = 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.listed x1.1 x0 x1.2 > 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.listed x1.1 x1.1 x1.2 > 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.member x1.1 x1 > 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.received x0 x1.2 x0 = 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.received x1.1 x1.2 x1.1 = 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.closed x1.1 x1.2 = 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.delivered x0 x1.2 x0 x1.2 = 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.delivered x1.1 x1.2 x1.1 x1.2 = 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.received_in x0 x1.2 x0 x1.2 = 0) ∧
  (∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.received_in x1.1 x1.2 x1.1 x1.2 = 0) ∧
  (∀ (x0 : A) (x1 : D) (x2 : A), s.received x0 x1 x2 > 0 → s.identity x0 > 0) ∧
  (∀ (x0 : A) (x1 : D) (x2 : A), s.received x0 x1 x2 > 0 → s.identity x2 > 0) ∧
  (∀ (x0 : A) (x1 : D) (x2 : A), s.received x0 x1 x2 > 0 → s.knows x0 x2 > 0) ∧
  (∀ (x0 : A) (x1 : D) (x2 : A), s.received x0 x1 x2 > 0 → s.knows x2 x0 > 0) ∧
  (∀ (x0 : A) (x1 : D) (x2 : A), s.received x0 x1 x2 > 0 → s.friend x0 x0 = 0) ∧

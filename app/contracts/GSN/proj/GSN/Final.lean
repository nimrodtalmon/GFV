  (∀ (x0 : A) (x1 : D), s.closed x0 x1 > 0 → s.delivered x0 x1 x0 x1 = 0) ∧
  (∀ (x0 : A) (x1 : D), s.closed x0 x1 > 0 → s.received_in x0 x1 x0 x1 = 0) ∧
  (∀ (x0 : A) (x1 : D) (x2 : D), s.posted x0 x1 x2 > 0 → s.identity x0 > 0) ∧
  (∀ (x0 : A) (x1 : D) (x2 : D), s.posted x0 x1 x2 > 0 → s.friend x0 x0 = 0) ∧
  (∀ (x0 : A) (x1 : D) (x2 : D), s.posted x0 x1 x2 > 0 → s.received x0 x1 x0 = 0) ∧

/-- closed(X, d)  ⇒  not member(X, <X>.d) -/
theorem p63_init : ∀ (x0 : A) (x1 : D), (init : St A D).closed x0 x1 > 0 → (init : St A D).member x0 (x0, x1) = 0 := by
  simp [init]


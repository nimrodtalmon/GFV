import GSN.Model
namespace GSN
variable {A D : Type} [DecidableEq A] [DecidableEq D]

/-- friend(X, Y)  ⇒  identity(Y) -/
theorem p18_init : ∀ (x0 : A) (x1 : A), (init : St A D).friend x0 x1 > 0 → (init : St A D).identity x1 > 0 := by
  simp [init]

theorem p18_step (s s' : St A D) (H0 : ∀ (x0 : A), s.identity x0 ≤ 1) (H1 : ∀ (x0 : A) (x1 : A), s.friend x0 x1 ≤ 1) (H2 : ∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → x0 ≠ x1) (H4 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 ≤ 1) (H12 : ∀ (x0 : A), s.identity x0 > 0 → s.friend x0 x0 = 0) (H13 : ∀ (x0 : A) (x1 : A), s.knows x0 x1 > 0 → s.identity x0 > 0) (H14 : ∀ (x0 : A) (x1 : A), s.knows x0 x1 > 0 → s.identity x1 > 0) (H15 : ∀ (x0 : A) (x1 : A), s.knows x0 x1 > 0 → s.friend x0 x0 = 0) (H16 : ∀ (x0 : A) (x1 : A), s.knows x0 x1 > 0 → s.friend x1 x1 = 0) (H17 : ∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.identity x0 > 0) (H18 : ∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.identity x1 > 0) (H19 : ∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.knows x0 x1 > 0) (H20 : ∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.knows x1 x0 > 0) (H21 : ∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.friend x0 x0 = 0) (H22 : ∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.friend x1 x0 > 0) (H23 : ∀ (x0 : A) (x1 : A), s.friend x0 x1 > 0 → s.friend x1 x1 = 0) (H24 : ∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.identity x0 > 0) (H25 : ∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.identity x1 > 0) (H26 : ∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.friend x0 x0 = 0) (H27 : ∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → s.friend x1 x1 = 0) (H34 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.identity x0 > 0) (H35 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.identity x1.1 > 0) (H36 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.friend x0 x0 = 0) (H37 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.friend x1.1 x1.1 = 0) (H38 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.listed x1.1 x0 x1.2 > 0) (H39 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.listed x1.1 x1.1 x1.2 > 0) (H40 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → s.member x1.1 x1 > 0) (H135 : ∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → x0 ≠ x1 → s.knows x0 x1 > 0) (H136 : ∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → x0 ≠ x1 → s.knows x1 x0 > 0) (H137 : ∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → x0 ≠ x1 → s.friend x0 x1 > 0) (H138 : ∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → x0 ≠ x1 → s.friend x1 x0 > 0) (H139 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → x0 ≠ x1.1 → s.knows x0 x1.1 > 0) (H140 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → x0 ≠ x1.1 → s.knows x1.1 x0 > 0) (H141 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → x0 ≠ x1.1 → s.friend x0 x1.1 > 0) (H142 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → x0 ≠ x1.1 → s.friend x1.1 x0 > 0) (h : Step s s') :
    ∀ (x0 : A) (x1 : A), s'.friend x0 x1 > 0 → s'.identity x1 > 0 := by
  cases h <;> grind


 : ∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → x0 ≠ x1 → s.knows x1 x0 > 0) (H137 : ∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → x0 ≠ x1 → s.friend x0 x1 > 0) (H138 : ∀ (x0 : A) (x1 : A) (x2 : D), s.listed x0 x1 x2 > 0 → x0 ≠ x1 → s.friend x1 x0 > 0) (H139 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → x0 ≠ x1.1 → s.knows x0 x1.1 > 0) (H140 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → x0 ≠ x1.1 → s.knows x1.1 x0 > 0) (H141 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → x0 ≠ x1.1 → s.friend x0 x1.1 > 0) (H142 : ∀ (x0 : A) (x1 : (A × D)), s.member x0 x1 > 0 → x0 ≠ x1.1 → s.friend x1.1 x0 > 0) (h : Step s s') :
    ∀ (x0 : A) (x1 : A), s'.friend x0 x1 > 0 → s'.knows x0 x1 > 0 := by
